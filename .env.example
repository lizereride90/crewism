DISCORD_TOKEN=put-your-token-here
DATABASE_URL=sqlite+aiosqlite:///crewism.db
LOG_LEVEL=INFO
# Optional: guild id for instant slash sync during dev
# COMMAND_GUILD_ID=
IMAGE_CACHE_DIR=assets/generated
# Dashboard (local only): bot API port, UI port, shared bearer token
DASHBOARD_PORT=3100
DASH_PORT=3000
# Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Or leave empty when using `npm start` (it generates a session token automatically)
DASHBOARD_TOKEN=
